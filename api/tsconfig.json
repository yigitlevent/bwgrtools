{
  "compilerOptions": {
    "target": "ESNext",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "composite": true,
    "isolatedModules": true,
    "noEmit": false,
    "noErrorTruncation": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "strict": true,
    "useDefineForClassFields": true,
    "outDir": "dist",
    "rootDir": "../"
  },
  "include": [
    "../shared/@types/*",
    "../shared/db/utils/*",
    "../shared/utils/*",
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ],
}